{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ComfyUI Portable",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/comfyUI-portable/ComfyUI-windows-portable/ComfyUI/main.py",
      "cwd": "${workspaceFolder}/comfyUI-portable/ComfyUI-windows-portable",
      "python": "${workspaceFolder}/comfyUI-portable/ComfyUI-windows-portable/python_embeded/python.exe",
      "console": "integratedTerminal",
      "args": ["--windows-standalone-build", "--disable-auto-launch"],
      "serverReadyAction": {
        "pattern": "To see the GUI go to:\\s+(https?://\\S+)",
        "action": "startDebugging",
        "name": "Open ComfyUI in VS Code Browser"
      }
    },
    {
      "name": "Open ComfyUI in VS Code Browser",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:8188"
    }
  ]
}
